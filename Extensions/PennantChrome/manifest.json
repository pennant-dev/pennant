{
  "manifest_version": 3,
  "name": "Pennant",
  "version": "0.2.0",
  "description": "Lets Pennant, on this Mac, work in tabs of its own in your Chrome: it clicks and types there without your mouse, and you can watch.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "tabGroups", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Pennant", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
